---
// The Cyfers app-icon glyph, traced as centre-line strokes from electron-assets/icon.png
// (1024px canvas coordinates) so it can be drawn in with stroke-dashoffset.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={["cap-mark", className]} viewBox="160 230 700 660" role="img" aria-label="Het Cyfers-logo: een studentenpet">
  <defs>
    <filter id="cap-shadow" x="-30%" y="-60%" width="160%" height="220%">
      <feGaussianBlur stdDeviation="18"></feGaussianBlur>
    </filter>
    <linearGradient id="cap-ink" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1d3d57"></stop>
      <stop offset="1" stop-color="#10213a"></stop>
    </linearGradient>
  </defs>
  <polygon class="cap-floor" points="512,712 760,830 512,880 264,830" filter="url(#cap-shadow)"></polygon>
  <g class="cap-strokes" fill="none" stroke-width="56" stroke-linejoin="miter" stroke-miterlimit="10">
    <path class="s1" pathLength="1" d="M633.5 363 L755 430 L512 561 L268 430 L512 296 Z" stroke="url(#cap-ink)"></path>
    <path class="s2" pathLength="1" d="M347 472 V638 L512 726 L677 638 V472" stroke="url(#cap-ink)"></path>
    <path class="s3" pathLength="1" d="M786 430 V648" stroke="var(--accent)"></path>
  </g>
</svg>

<style>
  .cap-mark {
    overflow: visible;
  }

  .cap-floor {
    fill: rgba(13, 27, 45, 0.28);
    transform-box: view-box;
    transform-origin: 512px 800px;
    animation: floor-in 1.6s 0.6s var(--ease) both;
  }

  .cap-strokes {
    animation: float 7s 2.4s ease-in-out infinite alternate;
  }

  .cap-strokes path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.5s var(--ease) forwards;
  }

  .cap-strokes .s1 {
    animation-delay: 0.15s;
  }

  .cap-strokes .s2 {
    animation-delay: 0.65s;
  }

  .cap-strokes .s3 {
    animation-delay: 1.25s;
    animation-duration: 0.8s;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes float {
    to {
      transform: translateY(-14px);
    }
  }

  @keyframes floor-in {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
  }
</style>
