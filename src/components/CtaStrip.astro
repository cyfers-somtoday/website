---
import { href } from "../site";

interface Props {
  heading: string;
  text: string;
}

const { heading, text } = Astro.props;
---

<section class="strip atmosphere">
  <div class="wrap inner" data-reveal>
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn-primary" href={href("/download/")}>
      Download Cyfers
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        ><path d="M4 10h12M11 5l5 5-5 5"></path></svg
      >
    </a>
  </div>
</section>

<style>
  .strip {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.75rem 3rem;
  }

  h2 {
    color: var(--navy);
    max-width: 18ch;
  }

  p {
    margin-top: 0.9rem;
    color: var(--muted);
    max-width: 34rem;
  }
</style>
