---
import { href } from "../site";

interface Link {
  path: string;
  label: string;
  detail: string;
}

interface Props {
  heading?: string;
  links: Link[];
}

const { heading = "Meer over Cyfers", links } = Astro.props;
---

<section class="section" aria-labelledby="related">
  <div class="wrap">
    <h2 id="related" data-reveal>{heading}</h2>
    <ul class="related-list">
      {
        links.map((link, i) => (
          <li data-reveal style={`--delay:${0.08 + i * 0.08}s`}>
            <a href={href(link.path)}>
              <span class="label">{link.label}</span>
              <span class="detail">{link.detail}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  h2 {
    color: var(--navy);
    max-width: 20ch;
  }

  .related-list {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-top: 1.5px solid var(--navy);
  }

  li a {
    display: grid;
    gap: 0.45rem;
    padding: 1.5rem 1.25rem 1.5rem 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--line);
    height: 100%;
  }

  .label {
    font: 700 clamp(1.15rem, 2vw, 1.35rem) / 1.25 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--navy);
    transition: color 0.2s;
  }

  a:hover .label {
    color: var(--accent-strong);
  }

  .detail {
    color: var(--muted);
    font-size: 0.98rem;
  }
</style>
