---
interface Item {
  q: string;
  a: string;
}

interface Props {
  heading?: string;
  items: Item[];
}

const { heading = "Veelgestelde vragen", items } = Astro.props;
const id = "landing-faq";
---

<section class="section tint" aria-labelledby={id}>
  <div class="wrap faq-wrap">
    <h2 id={id} data-reveal>{heading}</h2>
    <div class="items" data-reveal style="--delay:0.1s">
      {
        items.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p set:html={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    color: var(--navy);
  }

  .items {
    border-top: 1.5px solid var(--navy);
  }

  details {
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease),
      content-visibility 0.45s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
    font: 600 clamp(1.05rem, 1.6vw, 1.2rem) / 1.35 var(--font-body);
    transition: color 0.2s;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent-strong);
  }

  .icon {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }

  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate 0.35s var(--ease);
  }

  .icon::after {
    rotate: 90deg;
  }

  details[open] .icon::after {
    rotate: 0deg;
  }

  .answer {
    padding-bottom: 1.5rem;
    max-width: 40rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .faq-wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
