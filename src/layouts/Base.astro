---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { href } from "../site";

interface Props {
  title: string;
  description: string;
  /** Mark the nav item for the current page. */
  current?: string;
  /** Optional robots directive (e.g. "noindex, follow" on 404). */
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, current, robots, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href("/og.jpg"), Astro.site);
const ogImageAlt = "Cyfers — Desktop-app voor Somtoday";
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <link rel="icon" type="image/png" sizes="32x32" href={href("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#142a40" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Cyfers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Naar de inhoud</a>
    <Header current={current} />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />

    <script>
      const targets = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
